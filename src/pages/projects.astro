---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---
<BaseLayout title="Projects">
  <h1 class="text-2xl font-bold mb-4">Mijn projecten</h1>
  <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <ProjectCard title="Portfolio Website" description="Deze site — Astro + Tailwind." />
    <ProjectCard title="Email Component Library" description="Reusable MJML patterns." />
    <ProjectCard title="Game Prototype" description="Mini puzzel met Canvas." />
  </section>
</BaseLayout>
