---
const { title, description, href = '#', imgSrc = null, tags = [] } = Astro.props
---

<article
  class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md"
>
  {
    imgSrc && (
      <a href={href} class="block overflow-hidden rounded-lg">
        <img
          src={imgSrc}
          alt={title}
          class="aspect-video w-full object-cover transition group-hover:scale-[1.02]"
          loading="lazy"
        />
      </a>
    )
  }

  <header class="mt-4">
    <h3 class="text-lg font-semibold tracking-tight text-slate-900">
      <a {href} class="hover:underline">{title}</a>
    </h3>
  </header>

  {description && <p class="mt-2 text-slate-600">{description}</p>}

  {
    tags?.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map((t: any) => (
          <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-700">{t}</li>
        ))}
      </ul>
    )
  }

  <div class="mt-4">
    <a {href} class="inline-flex items-center gap-1 text-blue-600 hover:underline">
      Bekijk project <span aria-hidden>→</span>
    </a>
  </div>
</article>
