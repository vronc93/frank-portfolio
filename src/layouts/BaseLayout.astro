---
import "../styles/global.css"; // Tailwind activeren
const { title = "Frank – Portfolio", currentPath = "/" } = Astro.props;
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <header class="border-b">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="font-semibold tracking-tight">Frank de Graaf</a>
        <nav class="flex gap-6">
          <a
            href="/"
            class={`hover:underline ${currentPath === "/" ? "underline underline-offset-8" : ""}`}
            >Home</a
          >
          <a
            href="/about"
            class={`hover:underline ${currentPath.startsWith("/about") ? "underline underline-offset-8" : ""}`}
            >About</a
          >
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
      <!-- hier komt de inhoud van elke pagina -->
    </main>

    <footer class="mt-16 border-t">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-slate-500">
        © {new Date().getFullYear()} Frank de Graaf · Built with Astro + Tailwind
      </div>
    </footer>
  </body>
</html>
