---
import "../styles/global.css";
const { title = "Frank" } = Astro.props;
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-white text-gray-900">
    <header class="border-b">
      <div class="mx-auto max-w-5xl px-[var(--container)] py-4 flex items-center gap-6">
        <a href="/" class="font-semibold">Frank</a>
        <nav class="flex gap-4 text-sm">
          <a href="/" class="hover:underline">Home</a>
          <a href="/about" class="hover:underline">About</a>
          <a href="/projects" class="hover:underline">Projects</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-[var(--container)] py-8">
      <slot />
    </main>

    <footer class="border-t">
      <div class="mx-auto max-w-5xl px-[var(--container)] py-6 text-sm text-gray-500">
        © {new Date().getFullYear()} Frank — Built with Astro + Tailwind
      </div>
    </footer>
  </body>
</html>
